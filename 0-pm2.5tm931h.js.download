@keyframes petalFall {
  0%   { transform: translateY(0px) rotate(0deg) scale(0.6); opacity: 0; }
  8%   { opacity: 1; }
  88%  { opacity: 0.9; }
  100% { transform: translateY(105vh) rotate(840deg) scale(1.1); opacity: 0; }
}
.wedding-petal {
  position: fixed;
  top: -30px;
  pointer-events: none;
